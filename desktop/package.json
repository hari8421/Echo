{
  "name": "echo-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Native macOS and Windows app for the Echo local agent",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main/attachments.js && node --check src/main/backend.js && node --check src/main/main.js && node --check src/main/menu.js && node --check src/main/preload.js && node --check src/renderer/app.js",
    "test": "node --test tests/*.test.js",
    "sidecar": "node scripts/build-sidecar.mjs",
    "build:mac": "npm run sidecar && node scripts/build-mac.mjs",
    "build:mac:arm64": "npm run sidecar && electron-builder --mac --arm64",
    "build:mac:x64": "npm run sidecar && electron-builder --mac --x64",
    "build:win": "npm run sidecar && electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.echo.agent.desktop",
    "productName": "Echo",
    "directories": {
      "output": "../dist/app",
      "buildResources": "build"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend",
        "filter": [
          "echo-sidecar",
          "echo-sidecar.exe"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
