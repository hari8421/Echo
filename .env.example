# Copy to .env (or put in $ECHO_HOME/.env) and adjust.

# Where Echo keeps docs, drafts, archive and its database.
# ECHO_HOME=~/.echo

# "ollama" (default, fully local) or "openai" (any OpenAI-compatible server).
# ECHO_PROVIDER=ollama

# Chat model. For Ollama, pull it first: ollama pull llama3.2
# Tool calling needs a capable model: llama3.1+, qwen2.5, mistral-nemo, etc.
# ECHO_MODEL=llama3.2

# Ollama: http://localhost:11434 (default)
# OpenAI-compatible: e.g. https://api.openai.com/v1
# ECHO_BASE_URL=

# Required only for provider=openai.
# ECHO_API_KEY=

# Optional: enables semantic search on top of keyword search.
# For Ollama: ollama pull nomic-embed-text
# ECHO_EMBED_MODEL=

# ECHO_TEMPERATURE=0.3
# ECHO_MAX_TOOL_STEPS=12

# Retries for transient model failures (network blip, 429/5xx) and the base
# backoff in seconds; the delay doubles after each retry.
# ECHO_LLM_RETRIES=2
# ECHO_LLM_RETRY_DELAY=1

# Long chats are compacted into a short summary before the context budget is
# exceeded. Older turns stay in the session database and the UI; only the model
# prompt is compressed. The summary is produced by the model when possible.
# ECHO_CONTEXT_CHARS=14000
# ECHO_CONTEXT_SUMMARY_CHARS=1800

# The native backend installs Playwright's Chromium on first launch if missing.
# Set to 0 to manage the browser yourself.
# ECHO_BROWSER_AUTO_INSTALL=1

# ECHO_AUTO_MEMORY=1

# Optional: custom system prompt appended to Echo's default instructions.
# ECHO_SYSTEM_PROMPT=

# Web UI bind settings (used by `echo-ai ui` defaults)
# ECHO_UI_HOST=127.0.0.1
# ECHO_UI_PORT=8765
